<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Log in — Chasely</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="authbox">
    <h1>Chasely</h1>
    <p class="sub">Get your invoices paid without the awkward follow-up.</p>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="/login">
      <label>Email</label>
      <input type="email" name="email" required />
      <label>Password</label>
      <input type="password" name="password" required />
      <div style="margin-top:20px;"><button type="submit">Log in</button></div>
    </form>
    <p style="margin-top:16px;font-size:.88rem;color:var(--ink-soft);">
      No account? <a href="/signup">Create one</a>
    </p>
  </div>
</body>
</html>
