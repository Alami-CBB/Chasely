<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Guides — Chasely</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <nav>
    <div class="brand">Chasely</div>
    <div class="navlinks"><a href="/">Home</a><a href="/login">Log in</a></div>
  </nav>
  <div class="container" style="max-width:640px;">
    <h1>Guides</h1>
    <% posts.forEach(p => { %>
      <div style="padding:18px 0;border-bottom:1px solid var(--line);">
        <a href="/blog/<%= p.slug %>" style="font-size:1.1rem;font-weight:600;"><%= p.title %></a>
        <p style="color:var(--ink-soft);margin:6px 0 0;"><%= p.description %></p>
      </div>
    <% }) %>
  </div>
</body>
</html>
